label>\n        <input id=\"track-filter\" value={query} onChange={(event) => setQuery(event.target.value)} placeholder=\"ID, estado, owner…\" />\n        <div className=\"track-list\" aria-live=\"polite\">\n          {filtered.map((track) => (\n            <button className={`track-card ${selected === track.trackId ? 'selected' : ''}`} key={track.trackId}\n                    onClick={() => setSelected(track.trackId)} type=\"button\">\n              <strong>{track.trackId}</strong>\n              <span>{track.step}</span>\n              <small>{track.owner} · rev {track.revision}</small>\n            </button>\n          ))}\n        </div>\n      </aside>\n\n      <main className=\"workspace\">\n        {status === 'loading' && <State title=\"Leyendo BoxGhost\" body=\"Validando la raíz configurada y los tracks disponibles.\" />}\n        {status === 'empty' && <State title=\"Workspace vacío\" body=\"No se encontraron tracks válidos en la raíz configurada.\" />}\n        {status === 'unauthorized' && <State title=\"Acceso no autorizado\" body=\"La lectura fue rechazada sin exponer contenido restringido.\" />}\n        {status === 'error' && <State title=\"BoxGhost no disponible\" body={error || 'Verifica la configuración local.'} />}\n        {status === 'ready' && selected && !detail && <State title=\"Validando track\" body=\"Comprobando integridad, referencias y sensibilidad.\" />}\n        {detail && <TrackDetail detail={detail} />}\n      </main>\n    </div>\n  )\n}\n\nfunction State({ title, body }: { title: string; body: string }) {\n  return <section className=\"state-panel\"><div className=\"pulse\" /><h2>{title}</h2><p>{body}</p></section>\n}\n\nfunction TrackDetail({ detail }: { detail: DetailState }) {\n  const integrityTone = detail.track.integrity === 'VALID' ? 'good' : 'bad'\n  return <>\n    <section className=\"hero-panel\">\n      <div>\n        <p className=\"eyebrow\">TRACK ACTIVO</p>\n        <h2>{detail.track.trackId}</h2>\n        <p>{detail.track.step}</p>\n      </div>\n      <div className=\"status-row\">\n        <StatusPill value={detail.track.lifecycle} tone=\"good\" />\n        <StatusPill value={detail.track.integrity ?? 'UNKNOWN'} tone={integrityTone} />\n        <StatusPill value={`rev ${detail.track.revision}`} />\n        <StatusPill value={detail.track.scopeVersion} />\n      </div>\n    </section>\n\n    <section className=\"metrics-grid\">\n      <Metric label=\"Owner\" value={detail.track.owner} />\n      <Metric label=\"Eventos\" value={String(detail.timeline.total)} />\n      <Metric label=\"Aprobaciones\" value={String(detail.approvals.length)} />\n      <Metric label=\"Hallazgos\" value={String(detail.findings.length)} alert={detail.findings.length > 0} />\n    </section>\n\n    <section className=\"content-grid\">\n      <Panel title=\"Timeline\" subtitle={`${detail.timeline.total} eventos`}>\n        <div className=\"timeline\">\n          {detail.timeline.items.map((event, index) => <div className=\"timeline-item\" key={String(event.event_id ?? index)}>\n            <span className=\"timeline-dot\" />\n            <div><strong>{String(event.event_type ?? 'EVENT')}</strong><p>{String(event.workflow_step ?? event.occurred_at ?? '')}</p></div>\n          </div>)}\n          {!detail.timeline.items.length && <p className=\"muted\">Sin eventos registrados.</p>}\n        </div>\n      </Panel>\n      <Panel title=\"Hallazgos\" subtitle=\"Validación fail-closed\">\n        <div className=\"finding-list\">\n          {detail.findings.map((finding, index) => <article key={`${finding.code}-${index}`} className={`finding finding-${finding.severity.toLowerCase()}`}>\n            <StatusPill value={finding.severity} tone={finding.severity === 'ERROR' ? 'bad' : 'warn'} />\n            <div><strong>{finding.code}</strong><p>{finding.relativePath}{finding.lineNumber ? ` · línea ${finding.lineNumber}` : ''}</p></div>\n          </article>)}\n          {!detail.findings.length && <p className=\"clean-state\">✓ Sin hallazgos abiertos</p>}\n        </div>\n      </Panel>\n      <Panel title=\"Context Pack\" subtitle={detail.context.redacted ? 'Contenido enmascarado' : 'Contenido verificado'} wide>\n        <JsonView value={detail.context.content} />\n      </Panel>\n      <Panel title=\"Aprobaciones\" subtitle={`${detail.approvals.length} registros`}>\n        {detail.approvals.map((approval) => <article className=\"resource-card\" key={approval.relativePath}>\n          <StatusPill value={approval.validationStatus ?? approval.status} tone={approval.validationStatus === 'VALID' ? 'good' : 'warn'} />\n          <p>{approval.relativePath}</p>\n          {approval.redacted && <small>Contenido sensible enmascarado</small>}\n        </article>)}\n        {!detail.approvals.length && <p className=\"muted\">No existen aprobaciones registradas.</p>}\n      </Panel>\n      <Panel title=\"Decisiones\" subtitle={`${detail.decisions.length} registros`}>\n        {detail.decisions.map((decision) => <article className=\"resource-card\" key={decision.relativePath}>\n          <StatusPill value={decision.status} />\n          <p>{decision.relativePath}</p>\n        </article>)}\n        {!detail.decisions.length && <p className=\"muted\">No existen decisiones registradas.</p>}\n      </Panel>\n    </section>\n  </>\n}\n\nfunction Metric({ label, value, alert }: { label: string; value: string; alert?: boolean }) {\n  return <article className={`metric ${alert ? 'metric-alert' : ''}`}><span>{label}</span><strong>{value}</strong></article>\n}\n\nfunction Panel({ title, subtitle, wide, children }: { title: string; subtitle: string; wide?: boolean; children: React.ReactNode }) {\n  return <section className={`panel ${wide ? 'panel-wide' : ''}`}><header><h3>{title}</h3><span>{subtitle}</span></header>{children}</section>\n}\n","numLines":164,"startLine":1,"totalLines":164}},"sourceToolAssistantUUID":"91c6810a-19c5-4441-be05-6132c886fe1c","userType":"external","entrypoint":"claude-des