th path, String relativePath) {\n370\t        String extension = extension(path);\n371\t        if (!ALLOWED_EXTENSIONS.contains(extension)) {\n372\t            return new LinkedHashMap<>(Map.of(\"relativePath\", relativePath, \"status\", \"UNSUPPORTED_MEDIA_TYPE\"));\n373\t        }\n374\t        String raw = readRaw(path);\n375\t        String masked = maskSecrets(raw);\n376\t        Map<String, Object> result = new LinkedHashMap<>();\n377\t        result.put(\"relativePath\", relativePath);\n378\t        result.put(\"sha256\", sha256(path));\n379\t        result.put(\"redacted\", !raw.equals(masked));\n380\t        result.put(\"status\", \"READ_ONLY\");\n381\t        if (\"json\".equals(extension)) {\n382\t            try { result.put(\"content\", mapper.readTree(masked)); }\n383\t            catch (JacksonException exception) { result.put(\"content\", Map.of(\"error\", \"INVALID_JSON\")); }\n384\t        } else result.put(\"content\", masked);\n385\t        return result;\n386\t    }\n387\t\n388\t    private String approvalStatus(String trackId, JsonNode approval) {\n389\t        if (!trackId.equals(approval.path(\"track_id\").asString())) return \"APPROVAL_AUTHORITY_INVALID\";\n390\t        if (approval.path(\"revoked_at\").isTextual() || \"REVOKED\".equals(approval.path(\"decision\").asString())) return \"APPROVAL_REVOKED\";\n391\t        String expiresAt = approval.path(\"expires_at\").asString(\"\");\n392\t        if (!expiresAt.isBlank()) {\n393\t            try { if (OffsetDateTime.parse(expiresAt).toInstant().isBefore(Instant.now())) return \"APPROVAL_EXPIRED\"; }\n394\t            catch (DateTimeParseException exception) { return \"APPROVAL_INVALID\"; }\n395\t        }\n396\t        String scopeRef = approval.path(\"scope_ref\").asString(\"\");\n397\t        String expected = approval.path(\"scope_sha256\").asString(\"\");\n398\t        if (scopeRef.isBlank()) return \"APPROVAL_SCOPE_MISSING\";\n399\t        Path scope;\n400\t        try { scope = trackFile(trackId, scopeRef, false); }\n401\t        catch (PublicApiException exception) { return \"APPROVAL_SCOPE_MISSING\"; }\n402\t        if (!Files.isRegularFile(scope, LinkOption.NOFOLLOW_LINKS)) return \"APPROVAL_SCOPE_MISSING\";\n403\t        if (!expected.matches(\"[0-9a-f]{64}\") || !expected.equals(sha256(scope))) return \"APPROVAL_SCOPE_HASH_MISMATCH\";\n404\t        if (\"APPROVED_WITH_CONDITIONS\".equals(approval.path(\"decision\").asString())\n405\t                && approval.path(\"conditions\").size() == 0) return \"APPROVAL_CONDITION_MISSING\";\n406\t        return \"VALID\";\n407\t    }\n408\t\n409\t    private Path root() {\n410\t        if (properties.boxghostRoot() == null || properties.boxghostRoot().isBlank()) {\n411\t            throw new PublicApiException(HttpStatus.SERVICE_UNAVAILABLE, \"BOXGHOST_ROOT_NOT_CONFIGURED\");\n412\t        }\n413\t        try {\n414\t            Path configured = Paths.get(properties.boxghostRoot());\n415\t            if (!configured.isAbsolute()) throw new PublicApiException(HttpStatus.SERVICE_UNAVAILABLE, \"BOXGHOST_ROOT_INVALID\");\n416\t            return configured.toRealPath();\n417\t        } catch (IOException | RuntimeException exception) {\n418\t            if (exception instanceof PublicApiException api) throw api;\n419\t            throw new PublicApiException(HttpStatus.SERVICE_UNAVAILABLE, \"BOXGHOST_ROOT_UNAVAILABLE\");\n420\t        }\n421\t    }\n422\t\n423\t    private Path safeResolve(String relative, boolean mustExist) {\n424\t        if (relative == null || relative.isBlank() || relative.indexOf('\\0') >= 0) {\n425\t            throw new PublicApiException(HttpStatus.BAD_REQUEST, \"UNSAFE_PATH\");\n426\t        }\n427\t        Path requested;\n428\t        try { requested = Paths.get(relative.replace('/', java.io.File.separatorChar)); }\n429\t        catch (RuntimeException exception) { throw new PublicApiException(HttpStatus.BAD_REQUEST, \"UNSAFE_PATH\"); }\n430\t        if (requested.isAbsolute()) throw new PublicApiException(HttpStatus.BAD_REQUEST, \"UNSAFE_PATH\");\n431\t        for (Path segment : requested) if (\"..\".equals(segment.toString()) || segment.toString().isBlank()) {\n432\t            throw new PublicApiException(HttpStatus.BAD_REQUEST, \"UNSAFE_PATH\");\n433\t        }\n434\t        Path root = root();\n435\t        Path candidate = root.resolve(requested).normalize();\n436\t        if (!candidate.startsWith(root)) throw new PublicApiException(HttpStatus.BAD_REQUEST, \"UNSAFE_PATH\");\n437\t        try {\n438\t            if (Files.exists(candidate, LinkOption.NOFOLLOW_LINKS)) {\n439\t                Path real = candidate.toRealPath();\n440\t                if (!real.startsWith(root)) throw new PublicApiException(HttpStatus.BAD_REQUEST, \"REFERENCE_OUTSIDE_ROOT\");\n441\t                if (Files.isSymbolicLink(candidate)) throw new PublicApiException(HttpStatus.BAD_REQUEST, \"REFERENCE_OUTSIDE_ROOT\");\n442\t                return real;\n443\t            }\n444\t            Path parent = candidate.getParent();\n445\t            if (parent != null && Files.exists(parent, LinkOption.NOFOLLOW_LINKS) && !parent.toRealPath().startsWith(root)) {\n446\t                throw new PublicApiException(HttpStatus.BAD_REQUEST, \"REFERENCE_OUTSIDE_ROOT\");\n447\t            }\n448\t            if (mustExist) throw new PublicApiException(HttpStatus.NOT_FOUND, \"RESOURCE_NOT_FOUND\");\n449\t            return candidate;\n450\t        } catch (IOException exception) {\n451\t            throw readFailure();\n452\t        }\n453\t    }\n454\t\n455\t    private Path trackFile(String trackId, String relative, boolean mustExist) {\n456\t        validateTrackId(trackId);\n457\t        return safeResolve(\"tracks/\" + trackId + \"/\" + relative, mustExist);\n458\t    }\n459\t\n460\t    private String readRaw(Path path) {\n461\t        try {\n462\t            if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) {\n463\t                throw new PublicApiException(HttpStatus.NOT_FOUND, \"RESOURCE_NOT_FOUND\");\n464\t            }\n465\t            long size = Files.size(path);\n466\t            if (size > properties.limits().maxFileBytes()) {\n467\t                throw new PublicApiException(HttpStatus.UNPROCESSABLE_ENTITY, \"FILE_SIZE_LIMIT_EXCEEDED\");\n468\t            }\n469\t            if (!ALLOWED_EXTENSIONS.contains(extension(path))) {\n470\t                throw new PublicApiException(HttpStatus.UNSUPPORTED_MEDIA_TYPE, \"UNSUPPORTED_MEDIA_TYPE\");\n471\t            }\n472\t            return Files.readString(path, StandardCharsets.UTF_8);\n473\t        } catch (IOException exception) {\n474\t            throw readFailure();\n475\t        }\n476\t    }\n477\t\n478\t    private String readMasked(Path path) { return maskSecrets(readRaw(path)); }\n479\t\n480\t    private boolean fileExceedsLimit(Path path) {\n481\t        try { return Files.size(path) > properties.limits().maxFileBytes(); }\n482\t        catch (IOException exception) { throw readFailure(); }\n483\t    }\n484\t\n485\t    static String maskSecrets(String value) {\n486\t        String masked = value;\n487\t        for (Pattern pattern : SECRET_PATTERNS) masked = pattern.matcher(masked).replaceAll(REDACTED);\n488\t        return masked;\n489\t    }\n490\t\n491\t    static boolean containsSecret(String value) { return !value.equals(maskSecrets(value)); }\n492\t\n493\t    private String sha256(Path path) {\n494\t        try {\n495\t            MessageDigest digest = MessageDigest.getInstance(\"SHA-256\");\n496\t            try (var input = Files.newInputStream(path)) {\n497\t                byte[] buffer = new byte[8192];\n498\t                int read;\n499\t                while ((read = input.read(buffer)) != -1) digest.update(buffer, 0, read);\n500\t            }\n501\t            return java.util.HexFormat.of().formatHex(digest.digest());\n502\t        } catch (IOException | NoSuchAlgorithmException exception) {\n503\t            throw readFailure();\n504\t        }\n505\t    }\n506\t\n507\t    private void validateTrackId(String trackId) {\n508\t        if (trackId == null || !TRACK_ID.matcher(trackId).matches()) {\n509\t            throw new PublicApiException(HttpStatus.BAD_REQUEST, \"INVALID_TRACK_ID\");\n510\t        }\n511\t    }\n512\t\n513\t    private static String extension(Path path) {\n514\t        String name = path.getFileName().toString();\n515\t        int dot = name.lastIndexOf('.');\n516\t        return dot < 0 ? \"\" : name.substring(dot + 1).toLowerCase(Locale.ROOT);\n517\t    }\n518\t\n519\t    private static Object parseInteger(String value) {\n520\t        try { return Integer.parseInt(value); }\n521\t        catch (RuntimeException exception) { return \"INVALID\"; }\n522\t    }\n523\t\n524\t    private static String stripQuotes(String value) {\n525\t        if (value.length() >= 2 && ((value.startsWith(\"\\\"\") && value.endsWith(\"\\\"\"))\n526\t                || (value.startsWith(\"'\") && value.endsWith(\"'\")))) return value.substring(1, value.length() - 1);\n527\t        return value;\n528\t    }\n529\t\n530\t    private static PublicApiException readFailure() {\n531\t        return new PublicApiException(HttpStatus.UNPROCESSABLE_ENTITY, \"RESOURCE_READ_FAILED\");\n532\t    }\n533\t}\n534\t"}]},"uuid":"6c392963-e130-43e8-ab0f-42a99ddeb813","timestamp":"2026-08-02T04:18:26.527Z","toolUseResult":{"type":"text","file":{"filePath":"D:\\NZXTG7\\GYPPORT\\GYPPORT ERP\\GYPPORT\\Modules\\gm-ai-workspace\\backend\\src\\main\\java\\com\\gypport\\aiworkspace\\workspace\\WorkspaceService.java","content":"package com.gypport.aiworkspace.workspace;\n\nimport com.gypport.aiworkspace.shared.Finding;\nimport com.gypport.aiworkspace.shared.PublicApiException;\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.DirectoryStream;\nimport java.nio.file.Files;\nimport java.nio.file.LinkOption;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.security.MessageDigest;\nimport java.security.NoSuchAlgorithmException;\nimport java.time.Instant;\nimport java.time.OffsetDateTime;\nimport java.time.format.DateTimeParseException;\nimport java.util.ArrayList;\nimport java.util.Comparator;\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Locale;\nimport java.util.Map;\nimport java.util.Set;\nimport java.util.regex.Matcher;\nimport java.util.regex.Pattern;\nimport java.util.stream.Stream;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.stereotype.Service;\nimport tools.jackson.core.JacksonException;\nimport tools.jackson.databind.JsonNode;\nimport tools.jackson.databind.ObjectMapper;\n\n@Service\npublic class WorkspaceService {\n    static final String REDACTED = \"[REDACTED_SECRET_PATTERN]\";\n    private static final Pattern TRACK_ID = Pattern.compile(\"^[A-Z0-9][A-Z0-9-]{2,99}$\");\n    private static final Pattern FRONT_MATTER = Pattern.compile(\"(?s)^---\\\\R(.*?)\\\\R---(?:\\\\R|$)\");\n    private static final Set<String> ALLOWED_EXTENSIONS = Set.of(\"md\", \"json\", \"jsonl\");\n    private static final Set<String> LIFECYCLE_STATES = Set.of(\"DRAFT\", \"ACTIVE\", \"PAUSED\", \"CLOSED\", \"ARCHIVED\");\n    private static final Set<String> SENSITIVITY_LEVELS = Set.of(\"PUBLIC\", \"INTERNAL\", \"CONFIDENTIAL\", \"RESTRICTED\", \"REDACTED\");\n    private static final Set<String> WORKFLOW_STEPS = Set.of(\n            \"01_CHATGPT_WORK_INITIAL_PROPOSAL\", \"02_CLAUDE_CHAT_CRITICAL_REVIEW\",\n            \"03_CHATGPT_WORK_ADJUSTMENT\", \"04_CLAUDE_CHAT_CONSOLIDATION\",\n            \"05_CHATGPT_WORK_HANDOFF_VERIFIABLE\", \"06_CLAUDE_CODE_READ_ONLY_AUDIT\",\n            \"07_CODEX_IMPLEMENTATION\", \"08_CLAUDE_CODE_FINAL_AUDIT\",\n            \"09_CLAUDE_CHAT_FINAL_CONSOLIDATION\", \"OWNER_GATE_EDUARDO\");\n    private static final Set<String> VALID_TRANSITIONS = Set.of(\n            \"01_CHATGPT_WORK_INITIAL_PROPOSAL->02_CLAUDE_CHAT_CRITICAL_REVIEW\",\n            \"02_CLAUDE_CHAT_CRITICAL_REVIEW->03_CHATGPT_WORK_ADJUSTMENT\",\n            \"03_CHATGPT_WORK_ADJUSTMENT->04_CLAUDE_CHAT_CONSOLIDATION\",\n            \"04_CLAUDE_CHAT_CONSOLIDATION->05_CHATGPT_WORK_HANDOFF_VERIFIABLE\",\n            \"05_CHATGPT_WORK_HANDOFF_VERIFIABLE->06_CLAUDE_CODE_READ_ONLY_AUDIT\",\n            \"06_CLAUDE_CODE_READ_ONLY_AUDIT->07_CODEX_IMPLEMENTATION\",\n            \"07_CODEX_IMPLEMENTATION->08_CLAUDE_CODE_FINAL_AUDIT\",\n            \"08_CLAUDE_CODE_FINAL_AUDIT->09_CLAUDE_CHAT_FINAL_CONSOLIDATION\");\n    private static final List<Pattern> SECRET_PATTERNS = List.of(\n            Pattern.compile(\"(?i)sk-(?:proj-)?[a-z0-9_-]{12,}\"),\n            Pattern.compile(\"AKIA[0-9A-Z]{16}\"),\n            Pattern.compile(\"(?i)(?:password|passwd|token|api[_-]?key)\\\\s*[:=]\\\\s*[^\\\\s,;\\\"']{6,}\"),\n            Pattern.compile(\"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----\"),\n            Pattern.compile(\"eyJ[a-zA-Z0-9_-]{8,}\\\\.eyJ[a-zA-Z0-9_-]{8,}\\\\.[a-zA-Z0-9_-]{8,}\"));\n\n    private final WorkspaceProperties properties;\n    private final ObjectMapper mapper;\n\n    public WorkspaceService(WorkspaceProperties properties, ObjectMapper mapper) {\n        this.properties = properties;\n        this.mapper = mapper;\n    }\n\n    public Map<String, Object> health() {\n        boolean configured = properties.boxghostRoot() != null && !properties.boxghostRoot().isBlank();\n        boolean available = false;\n        if (configured) {\n            try {\n                Path root = root();\n                available = Files.isDirectory(root.resolve(\"tracks\"), LinkOption.NOFOLLOW_LINKS);\n            } catch (RuntimeException ignored) {\n                available = false;\n            }\n        }\n        return Map.of(\"status\", available ? \"UP\" : \"DEGRADED\", \"configured\", configured,\n                \"boxghostAvailable\", available, \"mode\", \"READ_ONLY\");\n    }\n\n    public List<Map<String, Object>> listTracks(String query) {\n        String normalizedQuery = query == null ? \"\" : query.trim().toLowerCase(Locale.ROOT);\n        Path tracks = safeResolve(\"tracks\", true);\n        List<Map<String, Object>> result = new ArrayList<>();\n        try (DirectoryStream<Path> entries = Files.newDirectoryStream(tracks)) {\n            int scanned = 0;\n            for (Path entry : entries) {\n                if (++scanned > properties.limits().maxFilesPerTrack()) {\n                    throw new PublicApiException(HttpStatus.UNPROCESSABLE_ENTITY, \"TRACK_SCAN_LIMIT_EXCEEDED\");\n                }\n                String id = entry.getFileName().toString();\n                if (!Files.isDirectory(entry, LinkOption.NOFOLLOW_LINKS) || !TRACK_ID.matcher(id).matches()) continue;\n                if (!normalizedQuery.isEmpty() && !id.toLowerCase(Locale.ROOT).contains(normalizedQuery)) continue;\n                Map<String, String> state = readState(id, new ArrayList<>());\n                result.add(summary(id, state));\n            }\n        } catch (IOException exception) {\n            throw readFailure();\n        }\n        result.sort(Comparator.comparing(item -> item.get(\"trackId\").toString()));\n        return result;\n    }\n\n    public Map<String, Object> track(String trackId) {\n        validateTrackId(trackId);\n        List<Finding> findings = collectFindings(trackId);\n        Map<String, String> state = readState(trackId, findings);\n        Map<String, Object> result = new LinkedHashMap<>(summary(trackId, state));\n        result.put(\"workflowId\", state.getOrDefault(\"workflow_id\", \"NOT_DECLARED\"));\n        result.put(\"updatedAt\", state.getOrDefault(\"updated_at\", \"NOT_DECLARED\"));\n        result.put(\"sensitivity\", state.getOrDefault(\"sensitivity\", \"NOT_DECLARED\"));\n        result.put(\"findingsCount\", findings.size());\n        result.put(\"integrity\", findings.stream().noneMatch(f -> \"ERROR\".equals(f.severity())) ? \"VALID\" : \"INVALID\");\n        return result;\n    }\n\n    public Map<String, Object> timeline(String trackId, int page, int size) {\n        validateTrackId(trackId);\n        int pageSize = Math.min(size, properties.limits().maxEventsPage());\n        Path timeline = trackFile(trackId, \"dialog/events.jsonl\", false);\n        if (!Files.exists(timeline, LinkOption.NOFOLLOW_LINKS)) {\n            return Map.of(\"items\", List.of(), \"page\", page, \"size\", pageSize, \"total\", 0);\n        }\n        List<JsonNode> events = new ArrayList<>();\n        try (BufferedReader reader = Files.newBufferedReader(timeline, StandardCharsets.UTF_8)) {\n            String line;\n            while ((line = reader.readLine()) != null) {\n                if (line.getBytes(StandardCharsets.UTF_8).length > properties.limits().maxJsonlLineBytes()) {\n                    throw new PublicApiException(HttpStatus.UNPROCESSABLE_ENTITY, \"JSONL_LINE_LIMIT_EXCEEDED\");\n                }\n                if (line.isBlank()) continue;\n                events.add(mapper.readTree(maskSecrets(line)));\n            }\n        } catch (JacksonException exception) {\n            throw new PublicApiException(HttpStatus.UNPROCESSABLE_ENTITY, \"INVALID_JSONL\");\n        } catch (IOException exception) {\n            throw readFailure();\n        }\n        int from = Math.min(page * pageSize, events.size());\n        int to = Math.min(from + pageSize, events.size());\n        return Map.of(\"items\", events.subList(from, to), \"page\", page, \"size\", pageSize,\n                \"total\", events.size(), \"hasNext\", to < events.size());\n    }\n\n    public Map<String, Object> context(String trackId) {\n        validateTrackId(trackId);\n        Path context = trackFile(trackId, \"CONTEXT_PACK.md\", true);\n        return Map.of(\"trackId\", trackId, \"content\", readMasked(context), \"redacted\", containsSecret(readRaw(context)));\n    }\n\n    public List<Map<String, Object>> resources(String trackId, String directory) {\n        validateTrackId(trackId);\n        if (!Set.of(\"decisions\", \"approvals\").contains(directory)) {\n            throw new PublicApiException(HttpStatus.BAD_REQUEST, \"UNSUPPORTED_RESOURCE\");\n        }\n        Path folder = trackFile(trackId, directory, false);\n        if (!Files.exists(folder, LinkOption.NOFOLLOW_LINKS)) return List.of();\n        List<Map<String, Object>> resources = new ArrayList<>();\n        try (Stream<Path> files = Files.list(folder)) {\n            files.filter(path -> Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS))\n                    .sorted()\n                    .limit(properties.limits().maxFilesPerTrack())\n                    .forEach(path -> resources.add(resourceView(path, trackId + \"/\" + directory + \"/\" + path.getFileName())));\n        } catch (IOException exception) {\n            throw readFailure();\n        }\n        return resources;\n    }\n\n    public List<Map<String, Object>> approvals(String trackId) {\n        List<Map<String, Object>> approvals = resources(trackId, \"approvals\");\n        for (Map<String, Object> approval : approvals) {\n            Object content = approval.get(\"content\");\n            if (content instanceof JsonNode json) approval.put(\"validationStatus\", approvalStatus(trackId, json));\n            else approval.put(\"validationStatus\", \"APPROVAL_INVALID\");\n        }\n        return approvals;\n    }\n\n    public List<Finding> findings(String trackId) {\n        validateTrackId(trackId);\n        return collectFindings(trackId);\n    }\n\n    private List<Finding> collectFindings(String trackId) {\n        List<Finding> findings = new ArrayList<>();\n        Map<String, String> state = readState(trackId, findings);\n        if (!LIFECYCLE_STATES.contains(state.get(\"lifecycle_status\"))) {\n            findings.add(Finding.error(\"INVALID_LIFECYCLE_STATUS\", \"tracks/\" + trackId + \"/TRACK_STATE.md\"));\n        }\n        if (!\"GYPPORT_AI_COLLABORATION_9_STEP_V1\".equals(state.get(\"workflow_id\"))) {\n            findings.add(Finding.error(\"UNKNOWN_WORKFLOW\", \"tracks/\" + trackId + \"/TRACK_STATE.md\"));\n        }\n        if (!WORKFLOW_STEPS.contains(state.get(\"current_step\"))) {\n            findings.add(Finding.error(\"UNKNOWN_STEP\", \"tracks/\" + trackId + \"/TRACK_STATE.md\"));\n        }\n        try {\n            if (Integer.parseInt(state.getOrDefault(\"revision\", \"0\")) < 1) throw new NumberFormatException();\n        } catch (NumberFormatException exception) {\n            findings.add(Finding.error(\"REVISION_NOT_MONOTONIC\", \"tracks/\" + trackId + \"/TRACK_STATE.md\"));\n        }\n        validateManifest(trackId, findings);\n        validateTimeline(trackId, findings);\n        scanKnownFilesForSecrets(trackId, findings);\n        for (Map<String, Object> approval : resources(trackId, \"approvals\")) {\n            Object content = approval.get(\"content\");\n            if (content instanceof JsonNode json) {\n                String status = approvalStatus(trackId, json);\n                if (!\"VALID\".equals(status)) findings.add(Finding.warning(status, approval.get(\"relativePath\").toString()));\n            }\n        }\n        return List.copyOf(findings);\n    }\n\n    private void validateManifest(String trackId, List<Finding> findings) {\n        String relative = \"tracks/\" + trackId + \"/SOURCE_MANIFEST.json\";\n        Path manifest = trackFile(trackId, \"SOURCE_MANIFEST.json\", false);\n        if (!Files.exists(manifest, LinkOption.NOFOLLOW_LINKS)) {\n            findings.add(Finding.error(\"MISSING_REFERENCE\", relative));\n            return;\n        }\n        try {\n            JsonNode root = mapper.readTree(readRaw(manifest));\n            JsonNode files = root.path(\"files\");\n            if (!files.isArray()) {\n                findings.add(Finding.error(\"INVALID_MANIFEST\", relative));\n                return;\n            }\n            int count = 0;\n            for (JsonNode entry : files) {\n                if (++count > properties.limits().maxFilesPerTrack()) {\n                    findings.add(Finding.error(\"TRACK_SCAN_LIMIT_EXCEEDED\", relative));\n                    return;\n                }\n                String declaredPath = entry.path(\"path\").asString(\"\");\n                String expected = entry.path(\"sha256\").asString(\"\");\n                String sensitivity = entry.path(\"sensitivity\").asString(\"\");\n                String entryRelative = \"tracks/\" + trackId + \"/\" + declaredPath;\n                if (!SENSITIVITY_LEVELS.contains(sensitivity)) {\n                    findings.add(Finding.error(\"SENSITIVITY_NOT_DECLARED\", entryRelative));\n                }\n                try {\n                    if (Paths.get(declaredPath.replace('/', java.io.File.separatorChar)).getNameCount()\n                            > properties.limits().maxReferenceDepth()) {\n                        findings.add(Finding.error(\"REFERENCE_DEPTH_LIMIT_EXCEEDED\", entryRelative));\n                        continue;\n                    }\n                } catch (RuntimeException exception) {\n                    findings.add(Finding.error(\"REFERENCE_OUTSIDE_ROOT\", entryRelative));\n                    continue;\n                }\n                Path target;\n                try {\n                    target = trackFile(trackId, declaredPath, false);\n                } catch (PublicApiException exception) {\n                    findings.add(Finding.error(\"REFERENCE_OUTSIDE_ROOT\", entryRelative));\n                    continue;\n                }\n                if (!ALLOWED_EXTENSIONS.contains(extension(target))) {\n                    findings.add(Finding.error(\"UNSUPPORTED_MEDIA_TYPE\", entryRelative));\n                } else if (!Files.isRegularFile(target, LinkOption.NOFOLLOW_LINKS)) {\n                    findings.add(Finding.error(\"MISSING_REFERENCE\", entryRelative));\n                } else if (fileExceedsLimit(target)) {\n                    findings.add(Finding.error(\"FILE_SIZE_LIMIT_EXCEEDED\", entryRelative));\n                } else if (expected.isBlank()) {\n                    findings.add(Finding.warning(\"INTEGRITY_NOT_DECLARED\", entryRelative));\n                } else if (!expected.matches(\"[0-9a-f]{64}\") || !expected.equals(sha256(target))) {\n                    findings.add(Finding.error(\"HASH_MISMATCH\", entryRelative));\n                }\n                if (Files.isRegularFile(target, LinkOption.NOFOLLOW_LINKS)\n                        && ALLOWED_EXTENSIONS.contains(extension(target)) && !fileExceedsLimit(target)\n                        && containsSecret(readRaw(target))) {\n                    findings.add(Finding.error(\"SECRET_PATTERN_DETECTED\", entryRelative));\n                }\n            }\n        } catch (JacksonException exception) {\n            findings.add(Finding.error(\"INVALID_JSON\", relative));\n        }\n    }\n\n    private void validateTimeline(String trackId, List<Finding> findings) {\n        Path path = trackFile(trackId, \"dialog/events.jsonl\", false);\n        if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) return;\n        String relative = \"tracks/\" + trackId + \"/dialog/events.jsonl\";\n        try (BufferedReader reader = Files.newBufferedReader(path, StandardCharsets.UTF_8)) {\n            String line;\n            int lineNumber = 0;\n            while ((line = reader.readLine()) != null) {\n                lineNumber++;\n                if (line.getBytes(StandardCharsets.UTF_8).length > properties.limits().maxJsonlLineBytes()) {\n                    findings.add(new Finding(\"JSONL_LINE_LIMIT_EXCEEDED\", \"ERROR\", relative, lineNumber, \"OPEN\"));\n                    continue;\n                }\n                if (line.isBlank()) continue;\n                try {\n                    JsonNode event = ma