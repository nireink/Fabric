ary.put(\"lifecycle\", state.getOrDefault(\"lifecycle_status\", \"INVALID\"));\n        summary.put(\"step\", state.getOrDefault(\"current_step\", \"INVALID\"));\n        summary.put(\"owner\", state.getOrDefault(\"current_owner\", \"INVALID\"));\n        summary.put(\"revision\", parseInteger(state.get(\"revision\")));\n        summary.put(\"scopeVersion\", state.getOrDefault(\"scope_version\", \"NOT_DECLARED\"));\n        return summary;\n    }\n\n    private Map<String, String> readState(String trackId, List<Finding> findings) {\n        validateTrackId(trackId);\n        Path state = trackFile(trackId, \"TRACK_STATE.md\", false);\n        String relative = \"tracks/\" + trackId + \"/TRACK_STATE.md\";\n        if (!Files.isRegularFile(state, LinkOption.NOFOLLOW_LINKS)) {\n            findings.add(Finding.error(\"TRACK_STATE_MISSING\", relative));\n            return Map.of();\n        }\n        Matcher matcher = FRONT_MATTER.matcher(readRaw(state));\n        if (!matcher.find()) {\n            findings.add(Finding.error(\"TRACK_STATE_INVALID\", relative));\n            return Map.of();\n        }\n        Map<String, String> result = new HashMap<>();\n        matcher.group(1).lines().forEach(line -> {\n            int separator = line.indexOf(':');\n            if (separator > 0) result.put(line.substring(0, separator).trim(), stripQuotes(line.substring(separator + 1).trim()));\n        });\n        if (!trackId.equals(result.get(\"track_id\"))) findings.add(Finding.error(\"TRACK_ID_MISMATCH\", relative));\n        return result;\n    }\n\n    private Map<String, Object> resourceView(Path path, String relativePath) {\n        String extension = extension(path);\n        if (!ALLOWED_EXTENSIONS.contains(extension)) {\n            return new LinkedHashMap<>(Map.of(\"relativePath\", relativePath, \"status\", \"UNSUPPORTED_MEDIA_TYPE\"));\n        }\n        String raw = readRaw(path);\n        String masked = maskSecrets(raw);\n        Map<String, Object> result = 